      "id": "1272-128104-0003",
      "audio": "/Users/jackboylan/workspace/speech-to-speech-phonon/progress/evaluations/librispeech-mini/1272-128104-0003.flac",
      "text": "HE HAS GRAVE DOUBTS WHETHER SIR FREDERICK LEIGHTON'S WORK IS REALLY GREEK AFTER ALL AND CAN DISCOVER IN IT BUT LITTLE OF ROCKY ITHACA",
      "word_errors": 2,
      "reference_words": 24,
      "wer": 0.08333333333333333
